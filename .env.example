# ============================================
# Environment Configuration Example
# Copy this file to .env and fill in your values
# ============================================

# API Configuration
# Local API URL (used by Streamlit to connect to API)
API_URL=http://127.0.0.1:8000

# NLTK Data Path (optional - auto-detected locally)
# For Render deployment, set to: /opt/render/project/src/nltk_data
# NLTK_DATA=/opt/render/project/src/nltk_data

# Python environment
# PYTHONUNBUFFERED=1  # For better logging in production

